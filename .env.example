# ===================================================
# RDS SMART LEARN — Production Environment Variables
# ===================================================

# Application Environment Mode ('development' | 'production')
NODE_ENV=development

# Demonstration Mode: set to 'true' ONLY to enable the optional development
# sample cohort. Default 'false' keeps the platform on real, genuine school data
# (and purges any legacy demo records automatically).
RDS_DEMO_MODE=false

# Application Base URL (used for password reset emails and callbacks)
APP_URL=http://localhost:3000

# Google Gemini AI API Key (Required for RDS AI tutoring, MCQ generation, and answer evaluations)
GEMINI_API_KEY=

# Initial Bootstrap Company Administrator Account (set these outside source control)
ADMIN_EMAIL=
ADMIN_INIT_PASSWORD=

# AI Usage & Quotas (Daily request limit per student, default: 100)
AI_DAILY_QUOTA_PER_STUDENT=100

# Session & Cookie Security
COOKIE_SECRET=

# Production Transactional Email Service (Optional for production password reset dispatch)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RDS SMART LEARN <no-reply@rdssmartlearn.com>"

# Optional Managed Cloud Database (e.g. Cloud SQL / Firestore if connecting to external cloud DB)
DATABASE_URL=
FIRESTORE_PROJECT_ID=
